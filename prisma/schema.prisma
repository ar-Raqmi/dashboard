generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CalendarEvent {
  id              String  @id @default(uuid())
  userId          String
  title           String
  date            String
  color           String?
  rrule           String?
  dtstart         String?
  recurrenceUntil String?
  recurrenceCount Int?
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Clock {
  id       String @id @default(uuid())
  userId   String
  label    String
  timezone String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DashboardLayout {
  id         String @id @default(uuid())
  userId     String
  layoutType String
  layouts    String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DashboardWidget {
  id      String  @id @default(uuid())
  userId  String
  type    String
  label   String
  icon    String
  visible Boolean
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FileItem {
  id             String     @id @default(uuid())
  userId         String
  name           String
  type           String
  category       String?
  parentId       String?
  size           Int?
  storageId      String?
  r2Key          String?
  storageSource  String?
  starred        Boolean?   @default(false)
  lastAccessed   Float?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  parent         FileItem?  @relation("FileItemToFileItem", fields: [parentId], references: [id], onDelete: Cascade)
  children       FileItem[] @relation("FileItemToFileItem")
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id        String      @id @default(uuid())
  userId    String
  title     String
  progress  Int
  order     Int?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones Milestone[]
}

model Milestone {
  id        String  @id @default(uuid())
  goalId    String
  label     String
  completed Boolean
  order     Int
  goal      Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  color     String
  pinned    Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecurrenceException {
  id         String   @id @default(uuid())
  userId     String
  entityType String
  entityId   String
  date       String
  status     String?
  newDate    String?
  title      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id              String   @id @default(uuid())
  userId          String
  title           String
  dueDate         String?
  priority        String
  status          String
  rrule           String?
  dtstart         String?
  recurrenceUntil String?
  recurrenceCount Int?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactorSecret {
  id          String   @id @default(uuid())
  userId      String
  accountName String
  secret      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  category    String?
  icon        String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String            @id @default(uuid())
  username        String            @unique
  passwordHash    String
  salt            String
  createdAt       DateTime          @default(now())
  calendarEvents  CalendarEvent[]
  clocks          Clock[]
  dashboardLayouts DashboardLayout[]
  dashboardWidgets DashboardWidget[]
  fileItems        FileItem[]
  goals            Goal[]
  notes            Note[]
  sessions         Session[]
  tasks            Task[]
  twoFactorSecrets TwoFactorSecret[]
  recurrenceExceptions RecurrenceException[]
  userSettings    UserSettings?
}

model UserSettings {
  id                  String  @id @default(uuid())
  userId              String  @unique
  profileName         String
  profilePicture      String?
  appTitle            String
  appLogo             String?
  iconBackgroundColor String
  hijriVisible        Boolean
  hijriOffset         Int
  hijriProvider       String  @default("calculated")
  hijriCalendar       String  @default("UmmAlQura")
  showSeconds         Boolean
  clipboardText       String
  backgroundType      String
  backgroundColor     String
  backgroundGradient  String
  backgroundImage     String
  backgroundOpacity   Int
  aladhanCity         String  @default("Kuala Lumpur")
  aladhanCountry      String  @default("Malaysia")
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

