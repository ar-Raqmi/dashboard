// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  username         String            @unique
  passwordHash     String
  salt             String
  createdAt        DateTime          @default(now())
  sessions         Session[]
  tasks            Task[]
  goals            Goal[]
  notes            Note[]
  events           CalendarEvent[]
  files            FileItem[]
  clocks           Clock[]
  widgets          DashboardWidget[]
  layouts          DashboardLayout[]
  settings         UserSettings?
  twoFactorSecrets TwoFactorSecret[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Task {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  dueDate   String?
  priority  String   // 'high' | 'medium' | 'low'
  status    String   // 'pending' | 'completed'
  createdAt DateTime @default(now())
}

model Goal {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  progress   Int
  order      Int?
  createdAt  DateTime    @default(now())
  milestones Milestone[]
}

model Milestone {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  label     String
  completed Boolean
  order     Int
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  color     String
  pinned    Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarEvent {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String
  date   String
  color  String?
}

model FileItem {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  type          String     // 'file' | 'folder'
  category      String?    // 'image' | 'audio' | 'pdf' | 'doc' | 'video' | 'folder' | 'other'
  parentId      String?
  parent        FileItem?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      FileItem[] @relation("FolderHierarchy")
  size          Int?
  storageId     String?
  r2Key         String?
  storageSource String?    // 'convex' | 'r2' | 'cloudflare'
  starred       Boolean?   @default(false)
  lastAccessed  Float?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Clock {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label    String
  timezone String
}

model DashboardWidget {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    String
  label   String
  icon    String
  visible Boolean
}

model DashboardLayout {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  layoutType String // 'desktop' | 'mobile' | 'notesDesktop' | 'notesMobile' | 'pinnedDesktop' | 'pinnedMobile' | 'goalsDesktop' | 'goalsMobile'
  layouts    String // JSON string of Layout[]
}

model UserSettings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileName         String
  profilePicture      String?
  appTitle            String
  appLogo             String?
  iconBackgroundColor String
  hijriVisible        Boolean
  hijriOffset         Int
  showSeconds         Boolean
  clipboardText       String
  backgroundType      String
  backgroundColor     String
  backgroundGradient  String
  backgroundImage     String
  backgroundOpacity   Int
}

model TwoFactorSecret {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountName String
  secret      String   // Encrypted/encoded TOTP secret
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}