# Copy to wrangler.toml (gitignored) and fill in your own IDs.
name = "ar-raqmi"
compatibility_date = "2025-01-01"
pages_build_output_dir = "dist"

[[d1_databases]]
binding = "DB"
database_name = "dashboard-db"
migrations_dir = "db/migrations"
database_id = "<your-d1-database-id>"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "ar-raqmi-files"
